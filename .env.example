# Copy to .env. Real values (the inference key) live in the team's password
# manager, never in the repo or a chat.

# Hub. Binds to localhost only: Caddy is the one public door.
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173

# "mock" plays the demo scenarios without Docker or an LLM (the real input
# scanner, context builder and role policies still run). "real" runs agents
# in sandboxes.
RUNNER=mock

# The hub's own checkout of the product repo: its `main`, with .hub/ roles.
# Relative paths resolve against apps/hub. RUNNER=real needs a git repo here;
# on the VM it's a clone of the GitHub demo repo, fetched before each task
# (see docs/deploying.md). The mock only reads files.
HUB_REPO_DIR=../../demo/shop
INCIDENTS_FILE=../../demo/incidents.json
# {id} becomes the task's short id. Previews aren't wired in the real runner yet.
PREVIEW_BASE_URL=https://{id}.preview.localhost

# Vultr Serverless Inference (OpenAI-compatible). Pick the model from
# `curl -H "Authorization: Bearer $VULTR_INFERENCE_API_KEY" https://api.vultrinference.com/v1/models`
VULTR_INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Pinned: answered the hub's INC-1042 prompt in the JSON edit format 5/5
# (2026-11-25). Check a new model the same way before switching.
INFERENCE_MODEL=deepseek-v4.1-flash-1017

# Where a green task's pull request opens (RUNNER=real). Empty: the hub only
# makes a task/<id> branch in HUB_REPO_DIR, with a file:// link.
# owner/name of the demo repo. It must be the repo HUB_REPO_DIR's `origin`
# points at: the branch is pushed to that origin, and this only builds the
# API URLs.
GITHUB_REPO=
# Fine-grained token for that one repo, from the password manager: Contents
# and Pull requests read/write, Metadata read, nothing else (a failed label
# only logs). Required with GITHUB_REPO. It reaches only the push and the API
# calls, never a sandbox.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Sandbox. `podman` works locally; the VM uses docker.
SANDBOX_DOCKER_BIN=docker
SANDBOX_IMAGE=team-workspace-sandbox:latest
# Set to runsc once gVisor is installed on the VM (see docs/deploying.md).
SANDBOX_RUNTIME=
# The internal Docker network from docker-compose.yml: its only way out is
# the egress proxy.
SANDBOX_NETWORK=sandbox
SANDBOX_REGISTRY_URL=http://verdaccio:4873/
# A fixed IP, not the service name: under runsc (gVisor) on an internal
# network there is no Docker DNS, so sandboxes can't resolve egress-proxy.
# docker-compose.yml pins the proxy to this address on 172.28.0.0/24.
SANDBOX_PROXY_URL=http://172.28.0.2:8080
# The proxy's denied-request log, published on the host's loopback only.
EGRESS_ADMIN_URL=http://127.0.0.1:8081

# Where per-task workspaces live. Deleted after each run.
TASKS_DIR=/var/lib/team-workspace/tasks
# Installed dependencies, one node_modules per package-lock.json hash, reused
# read-only by later tasks with the same lockfile. Only an install that passed
# the denied-log check and the install-script scanner lands here. Safe to
# delete when the hub is stopped; it refills on the next task.
DEPS_CACHE_DIR=/var/lib/team-workspace/deps
# Tasks running at once. Each one spends LLM tokens and VM CPU.
MAX_CONCURRENT_TASKS=2

# Public hostname for Caddy (docker-compose.yml). <vm-ip>.sslip.io gets a real
# certificate without touching DNS.
DOMAIN=localhost
